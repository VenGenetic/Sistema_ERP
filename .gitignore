# Pedidos generados con scripts/generar_pedido_importadora.py: llevan
# teléfonos de clientes y costos de la importadora, no van al repo.
pedido_importadora_*.xlsx

# Estado local del CLI de Supabase (versiones detectadas, url del pooler):
# es de esta máquina, no del proyecto.
supabase/.temp/

# Salidas de herramientas y compilaciones intermedias
*.tsbuildinfo
__pycache__/
*.pyc

# Audiencias para Meta Ads (scripts/meta/exportar-audiencias.js). Aunque los
# teléfonos van hasheados en SHA-256, un hash de un número de 12 dígitos se
# revierte por fuerza bruta en minutos: es una lista de clientes, no un secreto
# roto. Este repo es público, así que no entra.
feeds/audiencias-meta/

# Lista de rescate (scripts/meta/lista-rescate.js): teléfonos y nombres de
# clientes en claro para trabajarla desde la bandeja. No va al repo.
feeds/lista-rescate.csv
